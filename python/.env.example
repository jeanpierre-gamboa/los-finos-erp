# Copie este archivo a python/.env solo si necesita valores propios.
# Si no existe, se reutilizan DB_SERVER y DB_DATABASE de backend/.env.
# Autenticación integrada de Windows: no se requiere usuario ni contraseña.
DB_SERVER=
DB_DATABASE=LosFinosDB_Definitiva
# Opcional (por defecto: ODBC Driver 18 for SQL Server)
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
